# API Configuration
# Update this file with your backend API URL and settings

# Base API URL for backend
BASE_API_URL=http://localhost:5000

# API Version
API_VERSION=/api/v1

# Use mock data for development (set to false when backend is ready)
USE_MOCK_DATA=true

# App settings
APP_NAME=Shop Manager
APP_VERSION=1.0.0

# Feature flags
ENABLE_DEBUG_LOGGING=true
